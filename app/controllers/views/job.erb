
<h2>Job <%= @job.id %></h2>
</p>
<table>
<tr>
  <td>Run</td><td><a href='<%= "/dashboard/runs/#{@job.run_id}" %>' ><%= @job.run.name %></a></td>
</tr>
<tr>
  <td>Pipeline</td><td> <%= @job.pipeline.name %> (<%= @job.pipeline.description %>)</td>
</tr>
<tr>
  <td>Folder</td><td><a href='<%= "file://#{@job.run_dir}"%>' target="_blank"><%= @job.run_dir %></td>
</tr>
<tr>
  <td>Command</td><td><%= @job.command %></td>
</tr>
<tr>
  <td>Status</td><td bgcolor=<%= @color_by_status[@job.status] %>><%= @job.status %></td>
</tr>
<tr>
  <td>Log</td><td><a href='<%= "file://#{@job.log}"%>' target="_blank">open</td>
<% if @job.report %>
  <tr>
    <td>Report</td><td><a href='<%= "file://#{@job.report}"%>' target="_blank">open</td>
  </tr>
  <tr>
    <td>
      <form onsubmit="return confirm('Really remove this job and all results?')" action="/jobs/<%= @job.id %>/delete" method="GET">
        <input type="hidden" name="_method" value="DELETE">
        <button type="submit" class="button-delete">Delete</button>
      </form>
    </td>
    <td></td>  
  </tr>
<% end %>
</table>

<% libs = @job.libraries %>
<% if !libs.empty? %>
  <h3>Libraries included</h3>

  <table>
    <tr>
      <th>Library ID</th>
      <th>Lane</th>
      <th>R1</th>
      <th>R2</th>
      <th></th>
    </tr>
    <% libs.each do |lib| %>
      <tr>
        <td><%= lib.name %></td>
        <td><%= lib.lane %></td>
        <td><%= lib.R1 %></td>
        <td><%= lib.R2 %></td>
        
      </tr>
    <% end %>
  </table>
<% end %>
  

