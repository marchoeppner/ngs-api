
<h2>Job <%= @job.id %></h2>
</p>
<table>

  <td>Run</td><td><a href='<%= "/dashboard/runs/#{@job.run_id}" %>' ><%= @job.run.name %></a></td>
</tr>
<tr>
  <td>Pipeline</td><td> <%= @job.pipeline.name %> (<%= @job.pipeline.description %>)</td>
</tr>
<tr>
  <td>Folder</td><td><a href='<%= "file://#{@job.run_dir}"%>' target="_blank"><%= @job.run_dir %></td>
</tr>
<tr>
  <td>Command</td><td><%= @job.command %></td>
</tr>
<tr>
  <td>Status</td><td bgcolor=<%= @color_by_status[@job.status] %>><%= @job.status %></td>
</tr>
  <% if @parent %>
    <td>Parent Job</td><td><a href='<%= "/dashboard/jobs/#{@parent.id}" %>' ><%= @parent.id %> (<%= @parent.pipeline.name %>)</a></td>
  <% end %>
</tr>
<tr>  
  <td>Archived?</td>
  <% if @job.is_archived %>
    <% if @child %>
      <td><a href='<%= "/dashboard/jobs/#{@child.id}" %>' ><%= @child.id %> (<%= @child.pipeline.name %>)</a></td>
    <% else %>
      <td><%= @job.is_archived %></td>
    <% end %>
  <% else %>
    <td><%= @job.is_archived %></td>
  <% end %>
</tr>
<tr>
  <td>Log</td><td><a href='<%= "file://#{@job.log}"%>' target="_blank">open</td>
<% if @job.report %>
  <tr>
    <td>Report</td><td><a href='<%= "file://#{@job.report}"%>' target="_blank">open</td>
  </tr>
  </table>
  <table>
  <tr>
    <td>
      <form onsubmit="return confirm('Really remove this job and all results?')" action="/jobs/<%= @job.id %>/delete" method="GET">
        <input type="hidden" name="_method" value="DELETE">
        <button type="submit" class="button-delete">Delete</button>
      </form>
    </td>
    <% if @job.depends_on or @job.pipeline.runlevel or @job.is_archived %>
      <td></td>
    <% else %>
      <td><form onsubmit="return confirm('Really archive this job?')" action="/jobs/<%= @job.id %>/archive" method="GET">
          <input type="hidden" name="_method" value="DELETE">
          <button type="submit" class="button-delete">Archive</button>
        </form>
      </td>
    <% end %>
    </tr>
  </tr>
<% end %>
</table>

<% if @job.pipeline.name.include?("gabi") %>
  <form action="/jobs/<%= @job.id %>/bfr" method="GET">
<% end %>

<% libs = @job.libraries %>
<% if !libs.empty? %>
  <h3>Libraries included</h3>

  <table>
    <tr>
      <th></th>
      <th>Library ID</th>
      <th>Lane</th>
      <th>R1</th>
      <th>R2</th>
      <th></th>
    </tr>
    <% libs.each do |lib| %>
      <tr>
        <td><input type="checkbox" name="libs[]" value=<%= lib.id %>></td>
        <td><%= lib.name %></td>
        <td><%= lib.lane %></td>
        <td><%= lib.R1 %></td>
        <td><%= lib.R2 %></td>
        
      </tr>
    <% end %>
  </table>
<% end %>

<% if @job.pipeline.name.include?("gabi") %>

  <input type="button" class="my_form-check-button" onClick="checkAll(true);" value="Check All" />
  <input type="button" class="my_form-check-button" onClick="checkAll(false);" value="Clear All" />

  <p>

  <button type="submit" class="button-2">BfR Submit</button>

  </form>

  <script>
  function checkAll(checkEm) {
      var cbs = document.getElementsByTagName('input');

      for (var i = 0; i < cbs.length; i++) {
          if (cbs[i].type == 'checkbox') {
              if (cbs[i].name == 'libs[]') {
                  cbs[i].checked = checkEm;
              }
          }
      }
  }
  </script>

<% end %>