
 <p> 
<a href="/runs/register">Nach neuen Läufen suchen</a>
</p>

<table>
<tr>
  <th>Name</th>
  <th># Libraries</th>
  <th colspan=<%= @pipelines.length %>>Pipelines</th>
  <th></th>
</tr>
<% @runs.each do |run| %>
  <tr>
    <td><a href='<%= "dashboard/runs/#{run.id}" %>' ><%= run.name %></a></td>
    <td><a href='<%= "dashboard/runs/#{run.id}/libraries" %>'><%= run.libraries.length %></a></td>
    <% @pipelines.each do |pipeline| %>
    <% if run.pipelines.include?(pipeline) %>
      <% job = run.jobs.find{|j| j.pipeline_id == pipeline.id} %>
      <td bgcolor=<%= @color_by_status[job.status] %>>
        <% if job.status == "completed" || job.status == "failed" %>
          <a href="file://<%= job.run_dir %>" target="_blank" ><%= pipeline.name %></a>
        <% else %>
          <%= pipeline.name %></td>
        <% end %>
      </td>
    <% else %>
      <td><a href='<%= "runs/#{run.id}/create_job/#{pipeline.id}" %>'><%= pipeline.name %></a></td>
    <% end %>
  <% end %>
  <td>
    <form onsubmit="return confirm('Soll dieser Lauf aus der Liste gelöscht werden?')" action="/runs/<%= run.id %>/delete" method="GET">
      <input type="hidden" name="_method" value="DELETE">
      <button type="submit">Remove</button>
    </form>
  </td>
</tr>
<% end %>
</table>
